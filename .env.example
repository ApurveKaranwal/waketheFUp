# PostgreSQL Connection URL (e.g. Neon, Supabase, Docker, or local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/wtfup?sslmode=require"

# Redis Connection URL (e.g. Upstash, Docker, or local Redis)
REDIS_URL="rediss://default:token@accepted-endpoint.upstash.io:6379"

# Backend Port
PORT=4000

# Clerk server API secret key (never expose this in a NEXT_PUBLIC_ variable)
CLERK_SECRET_KEY="sk_test_replace_me"

# Comma-separated origins allowed to call the API from browsers
CORS_ORIGINS="http://localhost:3000"

# SMTP settings used for outage and recovery notifications (e.g. Resend, Sendgrid, SES)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASS="re_replace_with_resend_api_key"
EMAIL_FROM="onboarding@resend.dev"

# Maximum number of monitored endpoints per account
MAX_MONITORS_PER_USER=10

# Retain detailed checks and sent notification records for this many days
PING_HISTORY_RETENTION_DAYS=90
EMAIL_ALERT_RETENTION_DAYS=90
