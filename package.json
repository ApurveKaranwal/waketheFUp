{
  "name": "wakethefup",
  "license": "MIT",
  "scripts": {
    "dev": "bun run --parallel backend frontend",
    "dev:backend": "bun run backend/index.ts",
    "dev:frontend": "bun --cwd frontend dev",
    "backend": "bun run backend/index.ts",
    "backend:api": "bun run backend/api.ts",
    "backend:worker": "bun run backend/worker.ts",
    "frontend": "bun --cwd frontend dev",
    "build": "bun --cwd frontend build",
    "lint": "bun --cwd frontend lint",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test backend/controllers/monitorOwnership.integration.test.ts",
    "db:push": "bun x prisma db push --schema=backend/prisma/schema.prisma",
    "db:migrate:dev": "bun x prisma migrate dev --schema=backend/prisma/schema.prisma",
    "db:migrate:deploy": "bun x prisma migrate deploy --schema=backend/prisma/schema.prisma",
    "db:seed": "bun run backend/prisma/seed.ts",
    "db:studio": "bun x prisma studio --schema=backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/nextjs": "^7.9.14",
    "@prisma/client": "6",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.10",
    "hono": "^4.12.27",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.3",
    "prom-client": "^15.1.3",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "prisma": "6"
  }
}
